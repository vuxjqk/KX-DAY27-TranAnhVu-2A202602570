# LLM provider (OpenRouter is OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-v1-...
# openai/gpt-4o-mini needs purchased credits; on a free-tier key use a ":free" model, e.g.
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1
# Optional: override the sampling temperature. Reasoning models that only accept
# their built-in temperature need LLM_TEMPERATURE=default.
# LLM_TEMPERATURE=default

# Optional: HITL_DRY_RUN=1 skips posting comments to GitHub (bonus scripts set it by default)
# HITL_DRY_RUN=1

# SQLite database path (optional — defaults to ./hitl_audit.db in CWD)
# HITL_DB_PATH=hitl_audit.db

# GitHub Personal Access Token — REQUIRED.
#
# The agent calls the GitHub REST API directly. Generate a token at:
#   https://github.com/settings/tokens/new
# Scopes: tick `public_repo` (enough for VinUni-AI20k/PR-Demo — it's a public repo).
#
# Posting a top-level PR comment works for any authenticated user on a public repo.
# Formal reviews (Approve/Request-changes) would need collaborator status on the target.
GITHUB_TOKEN=

# Your GitHub username — recorded as `reviewer_id` on HITL rows in audit_events.
GITHUB_USER=
